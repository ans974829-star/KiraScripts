local function GodFarmLoop()
	task.spawn(function()
		while true do
			task.wait(0.05)
			if not getgenv().KiraHubAOTR then break end
			if not getgenv().GodFarm then continue end
			if getgenv().EmergencyStop then UpdateStatus("Paused — Emergency Stop") continue end
			if isLobby then continue end
			local char = player.Character
			if not char then continue end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then continue end
			local titansFolder = workspace:FindFirstChild("Titans")
			if not titansFolder then continue end
			if getgenv().DieAtStreak then
				local streak = tonumber(player:GetAttribute("Streak")) or 0
				if streak >= getgenv().DieAtStreakCount then
					local hum = char:FindFirstChild("Humanoid")
					if hum then pcall(function() hum.Health = 0 end) end
					task.wait(0.5)
					getgenv().GodFarm = false
					pcall(function() if Toggles and Toggles.GodFarmToggle then Toggles.GodFarmToggle:SetValue(false) end end)
					continue
				end
			end
			local validNapes = {}
			for _, t in ipairs(titansFolder:GetChildren()) do
				pcall(function()
					if t:GetAttribute("Killed") or t:GetAttribute("Dead") then return end
					local fake = t:FindFirstChild("Fake")
					if fake and fake:FindFirstChild("Collision") and not fake.Collision.CanCollide then return end
					local hum = t:FindFirstChildOfClass("Humanoid")
					if not hum or hum.Health <= 0 then return end
					local hit = t:FindFirstChild("Hitboxes") and t.Hitboxes:FindFirstChild("Hit")
					if not hit then return end
					local nape = hit:FindFirstChild("Nape")
					if nape then table.insert(validNapes, nape) end
				end)
			end
			if #validNapes == 0 then UpdateStatus("God Farm — Seeking") continue end
			local hitTargets = {validNapes[1]}
			if getgenv().MultiHit then
				local count = 1
				for i = 2, #validNapes do
					if count >= getgenv().MultiHitCount then break end
					table.insert(hitTargets, validNapes[i])
					count = count + 1
				end
			end
			local slotIndex = player:GetAttribute("Slot")
			local slotData = slotIndex and mapData and mapData.Slots and mapData.Slots[slotIndex]
			if slotData and slotData.Weapon == "Blades" then
				postRemote:FireServer("Attacks", "Slash", true)
				for _, nape in ipairs(hitTargets) do
					postRemote:FireServer("Hitboxes", "Register", nape, math.random(625, 850))
				end
			else
				for _, nape in ipairs(hitTargets) do
					postRemote:FireServer("Spears", "S_Explode", nape.Position)
					postRemote:FireServer("Hitboxes", "Register", nape, math.random(625, 850))
				end
			end
			UpdateStatus("God Farm — Attacking")
		end
	end)
end

