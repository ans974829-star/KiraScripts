local function getProfileList()
	local profiles = {}
	pcall(function()
		if not isfolder(CFG_PROFILES) then return end
		for _, f in pairs(listfiles(CFG_PROFILES)) do
			local name = f:match("([^/\\]+)%.json$")
			if name then table.insert(profiles, name) end
		end
	end)
	if #profiles == 0 then table.insert(profiles, "No profiles") end
	return profiles
end

