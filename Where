local AutoStartGroup = Tabs.Farm:AddRightGroupbox("Auto Start")
AutoStartGroup:AddToggle("AutoStartToggle", {
	Text="Auto Start", Default=false, Tooltip="Automatically creates and starts missions with selected settings",
	Callback=function(v)
		getgenv().AutoStart = v
		if getgenv().AutoStart and game.PlaceId == LOBBY_ID then
			task.spawn(function()
				local MAX_RETRIES = 10
				local retries = 0
				while getgenv().AutoStart do
					for _, mission in ipairs(ReplicatedStorage.Missions:GetChildren()) do
						if mission:FindFirstChild("Leader") and mission.Leader.Value == player.Name then
							getRemote:InvokeServer("S_Missions", "Leave")
						end
					end
					local missionType = Options.StartTypeDropdown and Options.StartTypeDropdown.Value or "Missions"
					local selectedDifficulty
					local mapName
					local objective
					if missionType == "Missions" then
						selectedDifficulty = Options.MissionDifficultyDropdown and Options.MissionDifficultyDropdown.Value or "Hardest"
						mapName = Options.MissionMapDropdown and Options.MissionMapDropdown.Value or "Shiganshina"
						objective = Options.MissionObjectiveDropdown and Options.MissionObjectiveDropdown.Value or "Skirmish"
					elseif missionType == "Raids" then
						selectedDifficulty = Options.RaidDifficultyDropdown and Options.RaidDifficultyDropdown.Value or "Hardest"
						mapName = Options.RaidMapDropdown and Options.RaidMapDropdown.Value or "Trost"
						objective = RaidObjectives[mapName] or "Attack Titan"
						mapName = RaidMapNames[mapName] or mapName
					elseif missionType == "Waves" then
						selectedDifficulty = "Easy"
						mapName = "Trost"
						objective = "Waves"
					end
					if mapName == "Booster Map" then
						local bm = resolveBoostedMapName()
						if not bm then task.wait(5) continue end
						mapName = bm
					end
					local created = false
					if selectedDifficulty == "Hardest" then
						local diffOrder = missionType == "Raids"
							and {"Aberrant","Severe","Hard"}
							or {"Aberrant","Severe","Hard","Normal","Easy"}
						for _, diff in ipairs(diffOrder) do
							if not getgenv().AutoStart then break end
							getRemote:InvokeServer("S_Missions", "Create", {
								Difficulty=diff, Type=missionType == "Raids" and "Raids" or "Missions",
								Name=mapName, Objective=objective
							})
							if getMyMission() then
								Library:Notify({Title="Auto Start", Description="Selected difficulty: "..diff, Time=3})
								created = true break
							end
						end
					else
						getRemote:InvokeServer("S_Missions", "Create", {
							Difficulty=selectedDifficulty, Type=missionType == "Raids" and "Raids" or "Missions",
							Name=mapName, Objective=objective
						})
						if getMyMission() then created = true end
					end
					if not getgenv().AutoStart then break end
					if not created then
						retries = retries + 1
						local backoff = math.min(retries * 2, 20)
						if retries >= MAX_RETRIES then
							Library:Notify({Title="Auto Start", Description="Failed after "..MAX_RETRIES.." retries. Stopping.", Time=10})
							getgenv().AutoStart = false
							Toggles.AutoStartToggle:SetValue(false)
							break
						end
						Library:Notify({Title="Auto Start", Description="Failed to create. Retry "..retries.."/"..MAX_RETRIES.." in "..backoff.."s", Time=backoff})
						task.wait(backoff)
						continue
					end
					retries = 0
					local activeMods = {}
					if Options.ModifiersDropdown and Options.ModifiersDropdown.Value then
						for modName, isActive in pairs(Options.ModifiersDropdown.Value) do
							if isActive then table.insert(activeMods, modName) end
						end
					end
					if #activeMods > 0 then
						for _, modifier in ipairs(activeMods) do
							getRemote:InvokeServer("S_Missions", "Modify", modifier)
						end
					end
					task.wait(0.5)
					if getgenv().WaitBeforeStart and getgenv().WaitBeforeStartSecs > 0 then
						Library:Notify({Title="Auto Start", Description="Waiting "..getgenv().WaitBeforeStartSecs.."s before starting...", Time=getgenv().WaitBeforeStartSecs})
						task.wait(getgenv().WaitBeforeStartSecs)
					end
					getRemote:InvokeServer("S_Missions", "Start")
					task.wait(5)
				end
			end)
		end
	end,
})

