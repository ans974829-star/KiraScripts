		pcall(function()
			local uc = workspace:FindFirstChild("Unclimbable")
			if not uc then return end
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not root then return end
			local titansFolder = workspace:FindFirstChild("Titans")
			local function tsAttack(range)
				if not titansFolder then return false end
				local closestNape = nil
				local closestDist = range or 40
				for _, t in ipairs(titansFolder:GetChildren()) do
					pcall(function()
						if t:GetAttribute("Killed") or t:GetAttribute("Dead") then return end
						local hum = t:FindFirstChildOfClass("Humanoid")
						if not hum or hum.Health <= 0 then return end
						local hit = t:FindFirstChild("Hitboxes") and t.Hitboxes:FindFirstChild("Hit")
						if not hit then return end
						local nape = hit:FindFirstChild("Nape")
						if nape then
							local dist = (root.Position - nape.Position).Magnitude
							if dist < closestDist then closestDist = dist closestNape = nape end
						end
					end)
				end
				if closestNape then
					postRemote:FireServer("Attacks", "Slash", true)
					postRemote:FireServer("Hitboxes", "Register", closestNape, math.random(625, 850))
					return true
				end
				return false
			end
			local function moveToPos(pos)
				root.CFrame = CFrame.new(pos)
				root.AssemblyLinearVelocity = Vector3.zero
			end
			if getgenv().TS_AutoBuildTowers then
				for _, obj in ipairs(workspace:GetChildren()) do
					if obj.Name:find("WatchTower_") and obj:IsA("Model") then
						local circle = obj:FindFirstChild("Circle")
						if circle and circle:FindFirstChild("Hitbox") then
							local hitbox = circle.Hitbox
							local dist = (root.Position - hitbox.Position).Magnitude
							if dist > 5 then moveToPos(hitbox.Position + Vector3.new(0, 3, 0)) end
							tsAttack(getgenv().TS_ZoneRange or 40)
							UpdateStatus("Building Tower: "..obj.Name)
							break
						end
					end
				end
			end
			if getgenv().TS_AutoProtectWagon then
				for _, obj in ipairs(workspace:GetDescendants()) do
					local n = obj.Name:lower()
					if (n:find("wagon") or n:find("carriage") or n:find("cart")) and obj:IsA("BasePart") then
						local dist = (root.Position - obj.Position).Magnitude
						if dist > 5 then moveToPos(obj.Position + Vector3.new(0, 3, 0)) end
						tsAttack(getgenv().TS_ZoneRange or 40)
						UpdateStatus("Protecting Wagon")
						break
					end
				end
			end
			if getgenv().TS_AutoRetrieveCrates then
				for _, obj in ipairs(uc:GetChildren()) do
					if obj.Name:find("ThunderSpear_Supplies") then
						local hitbox = obj:FindFirstChild("Hitbox")
						if hitbox and hitbox:IsA("BasePart") then
							local dist = (root.Position - hitbox.Position).Magnitude
							if dist > 5 then moveToPos(hitbox.Position + Vector3.new(0, 3, 0)) end
							task.wait(1.5)
							local dropZone = uc:FindFirstChild("Supplies_Circle")
							if dropZone then
								local dz = dropZone:FindFirstChild("Hitbox")
								if dz then moveToPos(dz.Position + Vector3.new(0, 5, 0)) end
							end
							UpdateStatus("Retrieving Crate")
							break
						end
					end
				end
			end
			if getgenv().TS_AutoDefendCrates then
				local dropZone = uc:FindFirstChild("Supplies_Circle")
				if dropZone then
					local dz = dropZone:FindFirstChild("Hitbox")
					if dz then
						local dist = (root.Position - dz.Position).Magnitude
						if dist > 5 then moveToPos(dz.Position + Vector3.new(0, 5, 0)) end
						tsAttack(getgenv().TS_ZoneRange or 40)
						UpdateStatus("Defending Drop Zone")
					end
				end
			end
			if getgenv().TS_AutoIceburstHunt then
				local obj = uc:FindFirstChild("Objective")
				if obj then
					for _, m in ipairs(obj:GetChildren()) do
						for _, d in ipairs(m:GetDescendants()) do
							if d:IsA("BasePart") then
								local dist = (root.Position - d.Position).Magnitude
								if dist > 5 then moveToPos(d.Position + Vector3.new(0, 3, 0)) end
								tsAttack(60)
								UpdateStatus("Iceburst Hunt")
								break
							end
						end
					end
				end
			end
		end)
	end
end)

