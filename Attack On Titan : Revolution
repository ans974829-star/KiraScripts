local function SaveKeyToFile(key)
    pcall(function()
        writefile(KEY_FILE, key)
    end)
end

local function LoadKeyFromFile()
    local success, key = pcall(function()
        if isfile(KEY_FILE) then
            local content = readfile(KEY_FILE)
            if content and content ~= "" then
                return content
            end
        end
        return nil
    end)
    if success and key then
        return key
    end
    return nil
end

local function SaveRememberPreference(value)
    pcall(function()
        writefile(REMEMBER_FILE, tostring(value))
    end)
end

local function LoadRememberPreference()
    local success, result = pcall(function()
        if isfile(REMEMBER_FILE) then
            return readfile(REMEMBER_FILE) == "true"
        end
        return false
    end)
    return success and result or false
end

local function ClearSavedKey()
