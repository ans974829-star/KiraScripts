		S.AutoSkipCutscene=true; S.DeleteMap=false
		notify("Config", "Waves Preset applied", 3)
	elseif preset == "Raids" then
		S.MinMissionTime=60; S.MultiHitCount=5; S.MultiHit=true; S.AutoFarm=true
		S.AutoRetry=true; S.AutoReload=true; S.AutoEscape=true; S.AntiInjury=true
