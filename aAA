		S.StartMap="Shiganshina"; S.StartObjective="Breach"; S.StartDifficulty="Hardest"
		S.AutoFarm=true; S.AutoRetry=true; S.SoloOnly=true; S.MovementMode="Teleport"
		S.DeleteMap=true; S.AutoExecute=true; S.AutoSkipCutscene=true; S.AutoChest=true
