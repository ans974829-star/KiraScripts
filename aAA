local function BypassMove(tp)
	LoadGD()
	if not GD.Root then return end
	if S.MovementMode == "Hover" then
		local dir = tp - GD.Root.Position
		local dist = dir.Magnitude
		if dist > 1 then
			GD.Root.AssemblyLinearVelocity = dir.Unit * math.clamp(dist * 8, 80, S.MoveSpeed)
		else
			GD.Root.AssemblyLinearVelocity = Vector3.zero
		end
	else
		local sp = GD.Root.Position
		local step = math.clamp(S.TeleportStep, 15, 650)
		local steps = math.max(1, math.ceil((tp - sp).Magnitude / step))
		local rot = GD.Root.CFrame - GD.Root.CFrame.Position
		for i = 1, steps do
			if S.EmergencyStop then break end
			if not GD.Root or not GD.Root.Parent then break end
			GD.Root.CFrame = CFrame.new(sp:Lerp(tp, i/steps)) * rot
			GD.Root.AssemblyLinearVelocity = Vector3.zero
			DisCol()
			RunService.Heartbeat:Wait()
		end
		if GD.Root and GD.Root.Parent then
			GD.Root.CFrame = CFrame.new(tp) * (GD.Root.CFrame - GD.Root.CFrame.Position)
			GD.Root.AssemblyLinearVelocity = Vector3.zero
		end
	end
end

