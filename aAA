				end
				return false
			end
			if S.AutoBoostGold then tryBoost({"2x Gold Boost [2h]","2x Gold Boost [1h]","2x Gold Boost [30m]","2x Gold Boost [15m]"}) task.wait(0.5) end
			if S.AutoBoostLuck then tryBoost({"2x Luck Boost [2h]","2x Luck Boost [1h]","2x Luck Boost [30m]","2x Luck Boost [15m]"}) task.wait(0.5) end
			if S.AutoBoostXP   then tryBoost({"2x XP Boost [2h]","2x XP Boost [1h]","2x XP Boost [30m]","2x XP Boost [15m]"})     task.wait(0.5) end
			task.wait(60)
