local function doAutoSkillTree()
	if not isLobby then return end
	local middlePath = SkillPaths.Blades[S.SkillMiddlePath] or SkillPaths.Spears[S.SkillMiddlePath]
	local leftPath = SkillPaths.Support[S.SkillLeftPath]
	local rightPath = SkillPaths.Defense[S.SkillRightPath]
	local pathMap = {Left=leftPath, Middle=middlePath, Right=rightPath}
	local orderedPaths = {}
	local used = {}
	for _, p in ipairs({S.SkillPriority1, S.SkillPriority2, S.SkillPriority3}) do
		if p ~= "None" and not used[p] and pathMap[p] then
			table.insert(orderedPaths, pathMap[p]) used[p] = true
		end
	end
	local anyUnlocked = false
	for _, path in ipairs(orderedPaths) do
		for _, skillId in ipairs(path) do
			if not getgenv().KiraHubAOTR or not S.AutoSkillTree then break end
			local ok, result = pcall(function() return getRemote:InvokeServer("S_Equipment", "Unlock", {skillId}) end)
			if ok and result ~= nil and result ~= false then anyUnlocked = true task.wait(0.4) end
		end
	end
	if not anyUnlocked then
		S.AutoSkillTree = false
		pcall(function() if Lib and Lib.Toggles and Lib.Toggles.AutoSkillTree then Lib.Toggles.AutoSkillTree:SetValue(false) end end)
		notify("Skill Tree", "All selected paths complete!", 4)
	end
end

local function doAutoPerkEnhance()
	if not isLobby then return end
	local slot = player:GetAttribute("Slot")
	if not slot then
		getRemote:InvokeServer("Functions", "Select", "A")
		task.wait(2)
		slot = player:GetAttribute("Slot")
	end
	if not slot then return end
	State.lastPlayerDataTime = 0
	State.lastPlayerData = nil
	local plrData = GetPlayerData()
	if not plrData or not plrData.Slots then return end
	local slotData = plrData.Slots[slot]
	if not slotData or not slotData.Perks then return end
	local equippedPerkId = slotData.Perks.Equipped and slotData.Perks.Equipped[S.PerkSlot]
	if not equippedPerkId then notify("Perk Enhance", "No perk in " .. S.PerkSlot .. " slot", 4) return end
	local storagePerks = {}
	for id, val in pairs(slotData.Perks.Storage or {}) do storagePerks[id] = val end
	local perkData = storagePerks[equippedPerkId]
	if not perkData then return end
	local rarity = GetPerkRarity(perkData.Name)
	if not rarity then return end
	local currentLevel = perkData.Level or 0
	local currentXP = perkData.XP or 0
	local allowedRarities = {}
	if type(S.PerkFoodRarities) == "table" then
		for _, r in ipairs(S.PerkFoodRarities) do allowedRarities[r] = true end
	end
	while getgenv().KiraHubAOTR and S.AutoPerkEnhance and currentLevel < 10 do
		local foodPerkDict = {}
		local totalXPGain = 0
		local count = 0
		for perkId, tbl in pairs(storagePerks) do
			if count >= 5 then break end
			local r = GetPerkRarity(tbl.Name)
			if perkId ~= equippedPerkId and r and allowedRarities[r] then
				foodPerkDict[perkId] = 1
				totalXPGain = totalXPGain + GetPerkXP(r, math.max(tbl.Level or 0, 1))
				count = count + 1
			end
		end
		if count == 0 then notify("Perk Enhance", "No food perks available", 4) break end
		local ok, result = pcall(function()
			return getRemote:InvokeServer("S_Equipment", "Enhance", equippedPerkId, foodPerkDict)
		end)
		if ok and result ~= nil and result ~= false then
			for id in pairs(foodPerkDict) do storagePerks[id] = nil end
			currentXP = currentXP + totalXPGain
			local thresholds = Perk_Level_XP[rarity]
			while currentLevel < 10 and thresholds do
				local needed = thresholds[currentLevel+1]
				if not needed or currentXP < needed then break end
				currentXP = currentXP - needed
				currentLevel = currentLevel + 1
			end
			notify("Perk Enhanced", perkData.Name .. " — Lv " .. currentLevel, 2)
		else
			notify("Perk Enhance", "Enhance failed", 4) break
		end
		task.wait(0.5)
	end
	S.AutoPerkEnhance = false
	pcall(function() if Lib and Lib.Toggles and Lib.Toggles.AutoPerkEnhance then Lib.Toggles.AutoPerkEnhance:SetValue(false) end end)
end

