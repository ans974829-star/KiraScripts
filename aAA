local function cannonStallColossal()
	if State.ColossalCannonRunning then return end
	local stallObj = ReplicatedStorage:FindFirstChild("Objectives") and ReplicatedStorage.Objectives:FindFirstChild("Stall_Colossal_Titan")
	if not stallObj then return end
	if stallObj.Value >= (stallObj:GetAttribute("Requirement") or 1) then return end
	local cannon = nil
	pcall(function()
		local walls = workspace:FindFirstChild("Climbable") and workspace.Climbable:FindFirstChild("Walls")
		if not walls then return end
		for _, w in ipairs(walls:GetChildren()) do
			local c = w:FindFirstChild("Cannons") and w.Cannons:FindFirstChild("1")
			if c then cannon = c break end
		end
	end)
	if not cannon then return end
	State.ColossalCannonRunning = true
	task.spawn(function()
		local impactConn = postRemote.OnClientEvent:Connect(function(a1, a2, cannonObj, ...)
			if a1 ~= "Skills" or a2 ~= "Impact" then return end
			if not State.ColossalCannonRunning then return end
			local ct = GD.Titans and GD.Titans:FindFirstChild("Colossal_Titan")
			if ct then
				local hit = ct:FindFirstChild("Hitboxes") and ct.Hitboxes:FindFirstChild("Hit")
				local nape = hit and hit:FindFirstChild("Nape")
				if nape then
					for i = 1, 30 do
						postRemote:FireServer("S_Skills", "Impact", cannon, nape.Position)
					end
				end
			end
		end)
		while getgenv().KiraHubAOTR and State.ColossalCannonRunning do
			local so = ReplicatedStorage:FindFirstChild("Objectives") and ReplicatedStorage.Objectives:FindFirstChild("Stall_Colossal_Titan")
			if not so or so.Value >= (so:GetAttribute("Requirement") or 1) then break end
			pcall(function()
				getRemote:InvokeServer("Cannon", "State", cannon, true)
				task.wait(0.1)
				getRemote:InvokeServer("Cannon", "Shoot", {BarrelWood=40, Base=0})
			end)
			task.wait(2)
