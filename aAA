local function roll(targets, rarities)
	if not PlayerGui or not PlayerGui:FindFirstChild("Interface") then return end
	if not INTERFACE:FindFirstChild("Customisation") or not INTERFACE.Customisation.Visible then return end
	local familyString = INTERFACE.Customisation.Family.Family.Title.Text
	local familyName = targets and string.lower(string.split(familyString, " ")[1]) or nil
	local familyRarity = string.lower(string.match(familyString, "%((.-)%)") or "")
	local stopRoll = false
	if targets and familyName and table.find(targets, familyName) then stopRoll = true end
	if rarities and table.find(rarities, familyRarity) then stopRoll = true end
	if familyRarity == "mythical" then stopRoll = true end
	if stopRoll then
		S.AutoRoll = false
		pcall(function()
			if Lib and Lib.Toggles and Lib.Toggles.AutoRollToggle then
				Lib.Toggles.AutoRollToggle:SetValue(false)
			end
		end)
		if familyRarity == "mythical" and S.PlayerWebhookURL and S.PlayerWebhookURL ~= "" then
			local rareMythicals = {"helos","fritz","reiss","tybur"}
			local isRareMythical = false
			for _, name in ipairs(rareMythicals) do
				if string.find(string.lower(familyString), name) then isRareMythical = true break end
			end
			postWH(S.PlayerWebhookURL, {
				content = isRareMythical and "🔥 RARE MYTHICAL! @everyone" or "✨ MYTHICAL FAMILY! @everyone",
				embeds = {{
					title = "Family Roll",
					color = isRareMythical and 16711680 or 16750848,
					description = string.format(
						"**Player:** `%s`\n**Family:** `%s`\n**Rare Mythical:** `%s`",
						player.Name, tostring(familyString), isRareMythical and "YES 🔥" or "No"
					),
					footer = {text = "Kira Hub - AOT:R"},
					timestamp = DateTime.now():ToIsoDate(),
				}}
			})
		end
		notify("Kira Hub", "Target family rolled: " .. familyString, 5)
		return
	end
	if INTERFACE:FindFirstChild("Warning") and INTERFACE.Warning.Prompt.Visible then
		UseButton(INTERFACE.Warning.Prompt.Main.Yes)
		task.wait(0.5)
	end
	if familyFrame and not familyFrame.Visible then
		UseButton(INTERFACE.Customisation.Categories.Family.Interact)
		task.wait(1)
	end
	if rollButton then UseButton(rollButton) end
end

