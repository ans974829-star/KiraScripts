		end
		local start = os.clock()
		local hasData = false
		if statsFrame then
			repeat
				task.wait(0.1)
				for _, v in ipairs(statsFrame:GetChildren()) do
					if v:IsA("Frame") and v:FindFirstChild("Amount") and v.Amount.Text ~= "0" and v.Amount.Text ~= "" then
						hasData = true break
					end
				end
			until hasData or (os.clock() - start) > 2
		end
		data.Stats = {}
		data.Items = {}
		data.Special = {}
		if statsFrame then
			for _, v in ipairs(statsFrame:GetChildren()) do
				if v:IsA("Frame") and v:FindFirstChild("Stat") and v:FindFirstChild("Amount") then
					data.Stats[v.Name:gsub("_"," ")] = v.Amount.Text
				end
			end
		end
		pcall(function()
			local res = getRemote:InvokeServer("S_Rewards", "Get", true)
			if res and res.Obtained then
				local ob = res.Obtained
				if ob.Gold   and ob.Gold   > 0 then data.Items["Gold"]   = tostring(ob.Gold)   SessionStats.TotalGold = SessionStats.TotalGold + ob.Gold end
				if ob.XP     and ob.XP     > 0 then data.Items["XP"]     = tostring(ob.XP)     SessionStats.TotalXP   = SessionStats.TotalXP   + ob.XP   end
				if ob.Gems   and ob.Gems   > 0 then data.Items["Gems"]   = tostring(ob.Gems)   SessionStats.TotalGems = SessionStats.TotalGems + ob.Gems end
				if ob.Canes  and ob.Canes  > 0 then data.Items["Canes"]  = tostring(ob.Canes)  end
				if ob.Shards and ob.Shards > 0 then data.Items["Shards"] = tostring(ob.Shards) end
				if ob.Silver and ob.Silver > 0 then data.Items["Silver"] = tostring(ob.Silver) end
				if ob.BP_XP  and ob.BP_XP  > 0 then data.Items["BP XP"]  = tostring(ob.BP_XP)  end
				if ob.Perks then
					for _, perkName in ipairs(ob.Perks) do
						data.Items["Perk: " .. perkName] = "1"
						if PerkRarityMap[perkName] == "Secret" then
							data.Special["Perk: " .. perkName] = "1"
						end
					end
				end
				if ob.Drops then
					for itemId, itemName in pairs(ob.Drops) do
						local name = tostring(itemName)
						local existing = tonumber(data.Items[name]) or 0
						data.Items[name] = tostring(existing + 1)
					end
				end
				if ob.Chests then
					for chestName, qty in pairs(ob.Chests) do
						if qty and qty > 0 then data.Items["Chest: " .. chestName] = tostring(qty) end
					end
				end
			end
		end)
		if itemsFrame then
			for _, v in ipairs(itemsFrame:GetChildren()) do
				if v:IsA("Frame") and v:FindFirstChild("Main") then
					local inner = v.Main:FindFirstChild("Inner")
					if inner and inner:FindFirstChild("Rarity") then
						local rc = inner.Rarity.BackgroundColor3
						local isMythical = math.abs(rc.R - 1) < 0.05 and math.abs(rc.G) < 0.05 and math.abs(rc.B) < 0.05
						if isMythical then
							local qty = inner:FindFirstChild("Quantity")
							local qtyText = qty and qty.Text or "1"
							data.Special[v.Name] = qtyText
							SessionStats.MythicalDrops = SessionStats.MythicalDrops + 1
							task.spawn(function()
								if S.PlayerWebhookEnabled and S.PlayerWebhookURL ~= "" then
									postWH(S.PlayerWebhookURL, {
										content = "@everyone MYTHICAL DROP!",
										embeds = {{
											title = "Mythical Drop",
											description = string.format(
												"**Player:** `%s`\n**Reward:** `%s`\n**Qty:** `x%s`",
												player.Name, tostring(v.Name), qtyText
											),
											color = 16766720,
											footer = {text="Kira Hub - AOT:R"},
											timestamp = DateTime.now():ToIsoDate(),
										}}
									})
								end
							end)
						end
					end
				end
			end
		end
		saveSession()
		task.spawn(function() sendRewardsWH(failed) end)
		if S.StreakProtect then
			local streak = tonumber(player:GetAttribute("Streak")) or 0
			if streak >= S.StreakProtectMax then
				notify("Streak Protection", "Retry disabled — streak at " .. streak, 5)
				return
			end
		end
		if S.AutoRetry and not failed then
			task.wait(S.RetryDelay)
			pcall(function()
				local rewardsGui = INTERFACE:FindFirstChild("Rewards")
				if rewardsGui and rewardsGui.Visible then
					local retryBtn = rewardsGui:FindFirstChild("Main")
