task.spawn(function()
	while task.wait(0.05) do
		if not getgenv().KiraHubAOTR then break end
		if not S.GodFarm then continue end
		if S.EmergencyStop then setFarmStatus("Paused — Emergency Stop") continue end
		if isLobby then continue end
		LoadGD()
		if not GD.Root or not GD.Titans or not postRemote or not getRemote then continue end
		if S.DieAtStreak then
			local streak = tonumber(player:GetAttribute("Streak")) or 0
			if streak >= S.DieStreakMax then
				setFarmStatus("Streak limit — dying")
				if GD.Humanoid then pcall(function() GD.Humanoid.Health = 0 end) end
				task.wait(0.5)
				S.GodFarm = false S.AutoFarm = false
				pcall(function() Toggles.GodFarm:SetValue(false) Toggles.AutoFarm:SetValue(false) end)
				releaseHold()
				continue
			end
		end
		if not check30sRule() then task.wait(0.3) continue end
		if State.IsHolding then holdInAir(GD.Root.Position) end
		handleBlades()
		local napes = getValidNapes()
		if #napes > 0 then
			local primary = napes[1]
			local hitTargets = {primary.nape}
			if S.MultiHit then
				local count = 1
				for i = 2, #napes do
					if count >= S.MultiHitCount then break end
					local tm = napes[i].model
					if not tm:GetAttribute("Dead") then
						table.insert(hitTargets, napes[i].nape)
						count = count + 1
					end
				end
			end
			if S.MultiHit then
				performMultiAttack(hitTargets)
			else
				performSingleAttack(primary.nape)
			end
			setFarmStatus("God Farm — Attacking")
		else
			setFarmStatus("God Farm — Seeking")
		end
	end
end)

task.spawn(function()
	while task.wait(0.05) do
		if not getgenv().KiraHubAOTR then break end
		if not S.AutoFarm then continue end
		if S.EmergencyStop then setFarmStatus("Paused — Emergency Stop") continue end
		if isLobby then continue end
		LoadGD()
		if not GD.Root or not GD.Titans or not GD.Humanoid or not postRemote or not getRemote then continue end
		if S.DieAtStreak then
			local streak = tonumber(player:GetAttribute("Streak")) or 0
			if streak >= S.DieStreakMax then
				setFarmStatus("Streak limit — dying")
				if GD.Humanoid then pcall(function() GD.Humanoid.Health = 0 end) end
				task.wait(0.5)
				S.GodFarm = false S.AutoFarm = false
				pcall(function() Toggles.GodFarm:SetValue(false) Toggles.AutoFarm:SetValue(false) end)
				releaseHold()
				continue
			end
		end
		if not check30sRule() then task.wait(0.3) continue end
		handleBlades()
		if S.MasteryFarm then
			local isShifted = GD.Character and GD.Character:GetAttribute("Shifter") or false
			local shiftReady = player:GetAttribute("Bar") == 100
			if not isShifted and shiftReady then
				pcall(function() getRemote:InvokeServer("S_Skills", "Usage", "999", false) end)
				task.wait(1)
				continue
			end
			if isShifted then
				local entries = getTargets(nil, 1)
				if #entries > 0 then
					local primary = entries[1]
					local titanHRP = primary.model:FindFirstChild("HumanoidRootPart")
					if titanHRP then
						GD.Root.AssemblyLinearVelocity = Vector3.zero
						GD.Root.CFrame = titanHRP.CFrame * CFrame.new(0, 0, 80)
					end
					local now = os.clock()
					local doPunch = S.MasteryMode == "Punching" or S.MasteryMode == "Both"
					local doSkills = S.MasteryMode == "Skill Usage" or S.MasteryMode == "Both"
					if doPunch and (now - State.LastMasteryPunch) >= 1 then
						State.LastMasteryPunch = now
						pcall(function()
							postRemote:FireServer("Attacks", "Slash", true)
							postRemote:FireServer("Hitboxes", "Register", primary.nape, nil, nil, State.MasteryComboIndex)
						end)
						State.MasteryComboIndex = State.MasteryComboIndex + 1
						if State.MasteryComboIndex > 4 then State.MasteryComboIndex = 1 end
					end
					if doSkills and not State.ShifterSkillsRunning then
						State.ShifterSkillsRunning = true
						task.spawn(function()
							local pd = GetPlayerData()
							if pd and pd.Slots then
								local slotIdx = player:GetAttribute("Slot")
								local slotData = slotIdx and pd.Slots[slotIdx]
								if slotData and slotData.Skills and slotData.Skills.Shifter then
									for _, skillId in ipairs(slotData.Skills.Shifter) do
										if not getgenv().KiraHubAOTR or not S.MasteryFarm then break end
										local idNum = tonumber(skillId)
										if idNum and idNum ~= 200 and idNum ~= 300 and idNum ~= 400
											and idNum ~= 210 and idNum ~= 211 and idNum ~= 306
											and idNum ~= 308 and idNum ~= 402 and idNum ~= 403 and idNum ~= 407 then
											pcall(function() getRemote:InvokeServer("S_Skills", "Usage", tostring(skillId), false) end)
										end
										task.wait(1)
									end
								end
							end
							State.ShifterSkillsRunning = false
						end)
					end
				end
				task.wait(0.05)
				continue
			end
		end
		local hitCount = S.MultiHit and S.MultiHitCount or 1
		local entries = getTargets(nil, hitCount)
		if #entries > 0 then
			local primary = entries[1]
			local titanHRP = primary.model:FindFirstChild("HumanoidRootPart")
			local targetPos
			if titanHRP then
				targetPos = (titanHRP.CFrame * CFrame.new(0, S.FloatHeight, 30)).Position
			else
				targetPos = primary.pos + Vector3.new(0, S.FloatHeight, 0)
			end
			if primary.isBoss then
				local dir = GD.Root.Position - primary.titanPos
				if dir.Magnitude > 0 then
					targetPos = primary.titanPos + dir.Unit * S.BossSafeDistance + Vector3.new(0, S.FloatHeight, 0)
				end
			end
			BypassMove(targetPos)
			DisCol()
			local napes = {}
			for _, e in ipairs(entries) do if e.nape then table.insert(napes, e.nape) end end
			if S.MultiHit then
				performMultiAttack(napes)
			else
				performSingleAttack(napes[1])
			end
			setFarmStatus("Auto Farm — Attacking")
		else
			setFarmStatus("Auto Farm — Seeking")
			pcall(function() if GD.Root then GD.Root.AssemblyLinearVelocity = Vector3.zero end end)
		end
	end
end)

