	return napes
end

local function getTargets(maxRange, count)
	count = count or 1
	local napes = getValidNapes()
	if #napes == 0 then return {} end
	local refPos = GD.Root.Position
	local pool = {}
	for _, entry in ipairs(napes) do
		local dist = (entry.pos - refPos).Magnitude
		if not maxRange or dist <= maxRange then
			table.insert(pool, {entry=entry, dist=dist})
		end
	end
	if S.RaidEngine then
		if S.RaidPriority == "Boss First" then
			table.sort(pool, function(a,b)
				if a.entry.isBoss and not b.entry.isBoss then return true end
				if b.entry.isBoss and not a.entry.isBoss then return false end
				return a.dist < b.dist
			end)
		elseif S.RaidPriority == "Adds First" then
			table.sort(pool, function(a,b)
				if a.entry.isBoss and not b.entry.isBoss then return false end
				if b.entry.isBoss and not a.entry.isBoss then return true end
				return a.dist < b.dist
			end)
		elseif S.RaidPriority == "Mixed" then
			local hasAdds = false
			for _, p in ipairs(pool) do if not p.entry.isBoss then hasAdds = true break end end
			table.sort(pool, function(a,b)
				if hasAdds then
					if a.entry.isBoss and not b.entry.isBoss then return false end
					if b.entry.isBoss and not a.entry.isBoss then return true end
				end
				return a.dist < b.dist
			end)
		else
			table.sort(pool, function(a,b) return a.dist < b.dist end)
		end
	else
		table.sort(pool, function(a,b) return a.dist < b.dist end)
	end
	local result = {}
	for i = 1, math.min(count, #pool) do
		table.insert(result, pool[i].entry)
	end
	return result
end

