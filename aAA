			if mission:FindFirstChild("Leader") and mission.Leader.Value == player.Name then
				getRemote:InvokeServer("S_Missions", "Leave") break
			end
		end
		task.wait(0.5)
		local mtype = S.StartType
		local mapName = S.StartMap
		local objective = S.StartObjective
		local difficulty = S.StartDifficulty
		if mtype == "Raids" then
			mapName = RaidMapNames[S.RaidStartMap] or S.RaidStartMap
			objective = RaidObjectives[S.RaidStartMap] or "Skirmish"
			difficulty = S.RaidStartDifficulty
		end
		if mapName == "Booster Map" then
			local bm = resolveBoostedMapName()
			if not bm then notify("Auto Start", "No boosted map found", 4) return end
			mapName = bm
		end
		local diffOrder = difficulty == "Hardest" and {"Aberrant","Severe","Hard","Normal","Easy"} or {difficulty}
		local created = false
		for _, diff in ipairs(diffOrder) do
			if created then break end
			pcall(function()
				getRemote:InvokeServer("S_Missions", "Create", {
					Difficulty=diff,
					Type=mtype == "Raids" and "Raids" or "Missions",
					Name=mapName,
					Objective=objective,
				})
			end)
