				getRemote:InvokeServer("S_Missions", "Create", {
					Difficulty = diff,
					Type = mtype == "Raids" and "Raids" or "Missions",
					Name = mapName,
					Objective = objective,
				})
			end)
			if getMyMission() then
				created = true
				notify("Auto Start", "Difficulty: " .. diff, 3)
			end
		end
		if not created then
			State.AutoStartRetries = State.AutoStartRetries + 1
			local backoff = math.min(State.AutoStartRetries * 2, 20)
			if State.AutoStartRetries >= 10 then
				notify("Auto Start", "Failed after 10 retries — stopping", 6)
				S.AutoStart = false
				pcall(function() Toggles.AutoStartToggle:SetValue(false) end)
				State.AutoStartRetries = 0
			else
				notify("Auto Start", "Retry " .. State.AutoStartRetries .. "/10 in " .. backoff .. "s", backoff)
				task.wait(backoff)
			end
			continue
		end
		State.AutoStartRetries = 0
		local mv = Options.ModifiersDropdown and Options.ModifiersDropdown.Value
		if type(mv) == "table" then
			for modName, isActive in pairs(mv) do
				if isActive then
					pcall(function() getRemote:InvokeServer("S_Missions", "Modify", modName) end)
					task.wait(0.05)
				end
			end
		end
		task.wait(0.3)
		pcall(function() getRemote:InvokeServer("S_Missions", "Start") end)
		task.wait(5)
	end
end)

