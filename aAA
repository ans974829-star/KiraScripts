		S.AllModifiersEnabled=true
		notify("Config", "Breach Preset applied", 3)
	elseif preset == "Defend" then
		S.StartMap="Utgard"; S.StartObjective="Defend"; S.StartDifficulty="Hardest"
		S.AutoFarm=true; S.AutoRetry=true; S.SoloOnly=true; S.MovementMode="Teleport"
		S.DeleteMap=true; S.AutoExecute=true; S.AutoSkipCutscene=true; S.AutoChest=true
		S.OpenSecondChest=true; S.MultiHitCount=3; S.WaitForLastTitan=true; S.WaitLastTitanTime=40
		S.AllModifiersEnabled=true
		notify("Config", "Defend Preset applied", 3)
	elseif preset == "Stall" then
		S.StartMap="Docks"; S.StartObjective="Stall"; S.StartDifficulty="Hardest"
		S.AutoFarm=true; S.AutoRetry=true; S.SoloOnly=true; S.MovementMode="Teleport"
		S.DeleteMap=false; S.AutoExecute=true; S.AutoSkipCutscene=true; S.AutoChest=true
		S.OpenSecondChest=true; S.MultiHitCount=2; S.MultiHit=false; S.AllModifiersEnabled=true
		notify("Config", "Stall Preset applied", 3)
	elseif preset == "Waves" then
		S.StartType="Missions"; S.StartMap="Trost"; S.StartObjective="Skirmish"; S.StartDifficulty="Easy"
		S.WavesAutoFarm=true; S.WavesAutoUpgrade=true; S.AutoFarm=true; S.AutoRetry=true
