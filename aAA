						and rewardsGui.Main.Info:FindFirstChild("Main")
						and rewardsGui.Main.Info.Main:FindFirstChild("Buttons")
						and rewardsGui.Main.Info.Main.Buttons:FindFirstChild("Retry")
					if retryBtn and retryBtn.Visible then
						UseButton(retryBtn)
					end
				end
			end)
		end
	end)
end

