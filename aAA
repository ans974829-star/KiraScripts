	task.spawn(function()
		while getgenv().KiraHubAOTR and S.AutoBoostEnabled do
			local function tryBoost(items)
				for _, itemName in ipairs(items) do
					local ok, result = pcall(function() return getRemote:InvokeServer("S_Inventory", "Item", itemName) end)
					if ok and result ~= nil and result ~= false then
						notify("Auto Boost", "Used: " .. itemName, 3) return true
