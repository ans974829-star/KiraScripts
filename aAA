end

local function formatItems(tbl)
	local str = ""
	for name, qty in pairs(tbl) do
		name = string.gsub(name, "_", " ")
		str = str .. string.format("[+] %s (x%s)\n", name, qty)
	end
	return str ~= "" and str or "None"
end

