local function check30sRule()
	if not (S.AutoFarm or S.GodFarm) then
		if State.IsHolding then releaseHold() end
		return true
	end
	local minTime = math.max(30, S.MinMissionTime or 30)
	if getTargets(nil,1) and #getTargets(nil,1) <= 1 and State.MissionStartTime > 0 then
		local elapsed = tick() - State.MissionStartTime
		if S.WaitForLastTitan or S.LastTitanWait then
			local waitTime = S.WaitForLastTitan and S.WaitLastTitanTime or S.LastTitanWaitSecs
			if elapsed < waitTime then
				setFarmStatus("Waiting last titan: " .. math.ceil(waitTime - elapsed) .. "s")
				if GD.Root then holdInAir(GD.Root.Position) end
				return false
			end
		elseif elapsed < minTime then
			setFarmStatus("Safety wait: " .. math.ceil(minTime - elapsed) .. "s")
			if GD.Root then holdInAir(GD.Root.Position) end
			return false
		end
	end
	if State.IsHolding then releaseHold() end
	return true
end

