task.spawn(function()
	while task.wait(0.3) do
		if not getgenv().KiraHubAOTR then break end
		if isLobby or S.EmergencyStop then continue end
		if not GD.Root or not postRemote or not getRemote then LoadGD() continue end
		if S.GodFarm or S.AutoFarm then continue end
		if S.TS_AutoBuildTowers then
			local towers = findActiveTowers()
			if #towers > 0 then
				tsCampZone(towers[1].part, "Tower " .. State.TS_TowerIndex)
			else
				local nextIdx = State.TS_TowerIndex + 1
				local foundNext = false
				for _, o in ipairs(workspace:GetChildren()) do
					if o.Name == "WatchTower_" .. nextIdx then foundNext = true break end
				end
				if foundNext then State.TS_TowerIndex = nextIdx State.TS_CurrentZone = nil
				elseif State.TS_TowerIndex <= 3 then setFarmStatus("Waiting Tower " .. State.TS_TowerIndex)
				else setFarmStatus("All Towers Built") releaseHold() end
			end
		end
		if S.TS_AutoProtectWagon then
			local activeTowers = findActiveTowers()
			if #activeTowers > 0 then continue end
			local wagon = findWagon()
			if wagon then tsCampZone(wagon, "Wagon Escort")
			else setFarmStatus("Wagon — Searching") releaseHold() end
		end
		if S.TS_AutoRetrieveCrates then
			local crates = findCrates()
			if #crates > 0 then
				local target = crates[1]
				if target.part and target.part.Parent then
					local dist = (GD.Root.Position - target.part.Position).Magnitude
					if dist > 8 then
						setFarmStatus("Crate " .. target.index .. " — Moving")
						BypassMove(target.part.Position + Vector3.new(0, 5, 0))
						DisCol()
					else
						setFarmStatus("Crate " .. target.index .. " — Pickup")
						local stayStart = tick()
						while tick() - stayStart < 2 do
							if not target.part or not target.part.Parent then break end
							if not GD.Root then break end
							pcall(function() GD.Root.CFrame = CFrame.new(target.part.Position + Vector3.new(0, 3, 0)) end)
							task.wait(0.2)
						end
						State.TS_CratesCollected[target.name] = true
						State.TS_CrateProgress = State.TS_CrateProgress + 1
						local dropZone = findDropZone()
						if dropZone then
							setFarmStatus("Crate " .. target.index .. " — Delivering")
							BypassMove(dropZone.Position + Vector3.new(0, 8, 0))
							DisCol()
							task.wait(1.5)
						end
					end
				end
			else
				setFarmStatus("All " .. State.TS_CrateProgress .. " crates collected")
				releaseHold()
			end
		end
		if S.TS_AutoDefendCrates then
			local pendingCrates = findCrates()
			if #pendingCrates > 0 and S.TS_AutoRetrieveCrates then continue end
			local dropZone = findDropZone()
			if dropZone then tsCampZone(dropZone, "Defending Drop Zone")
			else setFarmStatus("Drop Zone — Searching") releaseHold() end
		end
		if S.TS_AutoIceburstHunt then
			local objArea = nil
			pcall(function()
				local uc = workspace:FindFirstChild("Unclimbable")
				if not uc then return end
				local obj = uc:FindFirstChild("Objective")
				if obj then
					for _, m in ipairs(obj:GetChildren()) do
						for _, d in ipairs(m:GetDescendants()) do
							if d:IsA("BasePart") then objArea = d return end
						end
					end
				end
			end)
			if objArea then tsCampZone(objArea, "Iceburst Hunt")
			else
				setFarmStatus("Iceburst — Holding")
				if tsRateLimit() then
					local targets = getTargets(60, 1)
					if #targets > 0 and targets[1].nape then performSingleAttack(targets[1].nape) end
				end
			end
		end
	end
end)

