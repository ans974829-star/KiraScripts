		end
		if not created then notify("Auto Start", "Failed to create mission", 4) return end
		local mv = Options.ModifiersDropdown and Options.ModifiersDropdown.Value
		if type(mv) == "table" then
			for modName, isActive in pairs(mv) do
				if isActive then
					pcall(function() getRemote:InvokeServer("S_Missions", "Modify", modName) end)
					task.wait(0.05)
				end
			end
		end
